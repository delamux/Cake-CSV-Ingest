{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer test:*)",
      "Bash(composer stan:*)",
      "Bash(composer cs-check:*)",
      "Bash(composer check:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/phpcs:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run check:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(vendor/bin/phpcbf templates:*)",
      "Bash(vendor/bin/phpcbf:* templates*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(../crm.dev/vendor/gf-tic/**)"
    ]
  }
}
