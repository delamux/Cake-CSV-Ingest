{
    "name": "luisdelamo/cakephp-csv-ingest",
    "description": "CsvIngest: CSV import wizard plugin for CakePHP 5.4+ (column mapping, presets, foreign-key value maps, dry runs).",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": ["cakephp", "plugin", "csv", "import", "ingest"],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "cakephp/cakephp": "^5.4",
        "cakephp/migrations": "^4.9 || ^5.0",
        "league/csv": "^9.16"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3"
    },
    "autoload": {
        "psr-4": {
            "CsvIngest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CsvIngest\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "check": ["@cs-check", "@stan", "@test"],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit --colors=always"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
